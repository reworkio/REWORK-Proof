  "patterns": [
    {
      "id": "co-authored-by",
      "what": "A Co-authored-by trailer naming one of the tools above, in any casing (`Co-Authored-By`, `Co-authored-by`, `co-authored-by`).",
      "regex": "Co-?authored-?by:[^\\n]*?(?:{{tools}})"
    },
    {
      "id": "claude-session",
      "what": "The `Claude-Session:` trailer Claude Code writes beside its co-author line.",
      "regex": "(?:^|\\n)[ \\t]*Claude-Session:[ \\t]*\\S+"
    },
    {
      "id": "amp-thread-id",
      "what": "The `Amp-Thread-ID:` trailer Amp writes beside its co-author line.",
      "regex": "(?:^|\\n)[ \\t]*Amp-Thread-ID:[ \\t]*\\S+"
    },
    {
      "id": "generated-with",
      "what": "A `Generated with <tool>` or `Generated by <tool>` line, with or without a markdown link around the tool name. `Regenerated with build.js` is a human sentence about a script and does not count.",
      "regex": "\\bGenerated\\s+(?:with|by)\\s+\\[?(?:{{tools}})"
    },
    {
      "id": "robot-generated",
      "what": "The robot-emoji form, `🤖 Generated ...`, which some tools write without naming themselves on the same line.",
      "regex": "🤖\\s*Generated"
    },
    {
      "id": "assisted-by",
      "what": "An `Assisted-by:` trailer naming one of the tools above. The trailer several projects' AI policies ask for (LLVM, OpenStack, OpenInfra, OpenSSL).",
      "regex": "(?:^|\\n)[ \\t]*Assisted-by:[^\\n]*?(?:{{tools}})"
    },
    {
      "id": "assisted-by-agent-model",
      "what": "An `Assisted-by:` trailer in the `AGENT:MODEL` form (`Assisted-by: my-agent:my-model-v1`), whatever the agent is called. That form is what the Linux kernel's 7.0 and 7.1 documentation and OpenSSL's policy specify, and a person's name is not written that way. A link (`https://...`) is not an agent.",
      "regex": "(?:^|\\n)[ \\t]*Assisted-by:[ \\t]*[^\\s:<]+:(?!//)[^\\s<]+"
    },
    {
      "id": "generated-by",
      "what": "A `Generated-by:` trailer naming one of the tools above (the Apache Software Foundation's and OpenStack's form).",
      "regex": "(?:^|\\n)[ \\t]*Generated-by:[^\\n]*?(?:{{tools}})"
    },
    {
      "id": "ai-assisted-true",
      "what": "The line `AI-assisted: true` (or `yes`), which some projects write beside a co-author line. `AI-Assisted: none` is the opposite statement and never matches.",
      "regex": "(?:^|\\n)[ \\t]*AI-assisted:[ \\t]*(?:true|yes)\\b"
    },
    {
      "id": "replit-commit-author",
      "what": "The `Replit-Commit-Author: Agent` trailer Replit writes on commits its agent makes.",
      "regex": "(?:^|\\n)[ \\t]*Replit-Commit-Author:[ \\t]*Agent\\b"
    },
    {
      "id": "crush-generated",
      "what": "The `Generated with Crush` line Crush writes above its `Assisted-by:` trailer.",
      "regex": "💘\\s*Generated\\s+with\\s+Crush\\b"
    }
  ]
}
